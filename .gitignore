# ==========================================
# Archivo .gitignore para Node.js, React, NestJS y TypeScript
# Aplica a carpetas raíz, subproyectos y subcarpetas
# ==========================================

# ------------------------------------------
# 1. Dependencias y Administradores de Paquetes
# ------------------------------------------
**/node_modules/
**/.pnp
**/.pnp.js
**/.yarn/cache
**/.yarn/unplugged
**/.yarn/build-state.yml
**/.yarn/install-state.gz
**/.pnpm-store/

# ------------------------------------------
# 2. Archivos de Compilación y Outputs (Builds)
# ------------------------------------------
**/dist/
**/build/
**/out/
**/.next/
**/.nuxt/
**/.vuepress/dist/
**/.cache/
**/.serverless/
**/.fusebox/
**/.dynamodb/
**/.docusaurus/

# Logs y Archivos de Depuración
**/logs/
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# Diagnostic reports (Node.js)
**/report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# ------------------------------------------
# 3. Variables de Entorno y Secretos
# ------------------------------------------
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*.env.signed

# Excepción: Permitir archivo de ejemplo si existe
!**/.env.example

# ------------------------------------------
# 4. Pruebas y Cobertura (Jest, Vitest, Cypress)
# ------------------------------------------
**/coverage/
**/.nyc_output/
**/.vitest/
**/cypress/screenshots/
**/cypress/videos/
**/*.lcov

# ------------------------------------------
# 5. TypeScript y Caché de Herramientas
# ------------------------------------------
**/*.tsbuildinfo
**/.eslintcache
**/.stylelintcache
**/.prettiercache
**/.rollup.cache/
**/.swc/
**/.turbo/

# ------------------------------------------
# 6. Configuración de IDEs y Editores
# ------------------------------------------
# VS Code
**/.vscode/*
!**/.vscode/extensions.json
!**/.vscode/settings.json
!**/.vscode/tasks.json
!**/.vscode/launch.json

# WebStorm / JetBrains
**/.idea/
**/*.iw/
**/*.iws/
**/*.ipr/
**/*.iml

# Archivos del sistema operativo
**/.DS_Store
**/.DS_Store?
**/._*
**/.Spotlight-V100
**/.Trashes
**/ehthumbs.db
**/Thumbs.db

# ------------------------------------------
# 7. Archivos Temporales de NestJS / React
# ------------------------------------------
**/.nest/
**/.vite/